  <!-- ros2_control -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/t/49x_Hexapod/ros2_ws/install_final1/hexapod_bringup/share/hexapod_bringup/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
  <!-- Ground-truth odom -> base_link pose (simulation only), bridged to /tf by
         hexapod_simulation/config/bridge.yaml (/odom_tf). hexapod_perception's voxel_map_node
         uses it to keep its map fixed in the world. For evaluation only - never feed it
         to the gait-selection model. Replace with hexapod_state_estimation's odometry later. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
      <odom_topic>odom</odom_topic>
      <tf_topic>odom_tf</tf_topic>
    </plugin>
  </gazebo>
  <gazebo reference="front_left_foot_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="front_left_foot_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>100000.0</kp>
    <kd>10.0</kd>
    <sensor name="front_left_foot_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <!-- topic must match hexapod_simulation/config/bridge.yaml (/foot_contacts/<leg>) -->
      <topic>foot_contacts/front_left</topic>
      <contact>
        <!-- sdformat names the (single, unnamed) URDF collision "<link>_collision" -->
        <collision>front_left_foot_link_collision</collision>
        <topic>foot_contacts/front_left</topic>
      </contact>
    </sensor>
  </gazebo>
