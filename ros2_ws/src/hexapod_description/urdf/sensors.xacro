<?xml version="1.0"?>
<!-- Sensor frames (URDF part). Gazebo sensor plugins live in hexapod.gazebo.xacro.
     Poses are PLACEHOLDERS until the sensors are mounted (see hexapod_params.xacro). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== IMU ===== -->
  <link name="imu_link">
    <inertial>
      <mass value="${imu_mass}"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="body_link"/><child link="imu_link"/>
    <origin xyz="${imu_xyz}" rpy="${imu_rpy}"/>
  </joint>

  <!-- ===== Depth camera ===== -->
  <xacro:property name="cs" value="${xacro.tokenize(camera_size)}"/>
  <xacro:property name="csx" value="${float(cs[0])}"/>
  <xacro:property name="csy" value="${float(cs[1])}"/>
  <xacro:property name="csz" value="${float(cs[2])}"/>
  <link name="camera_link">
    <visual>
      <origin xyz="${-csx/2} 0 0" rpy="0 0 0"/>
      <geometry><box size="${csx} ${csy} ${csz}"/></geometry>
      <material name="sensor_blue"/>
    </visual>
    <collision>
      <origin xyz="${-csx/2} 0 0" rpy="0 0 0"/>
      <geometry><box size="${csx} ${csy} ${csz}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="${-csx/2} 0 0" rpy="0 0 0"/>
      <mass value="${camera_mass}"/>
      <inertia ixx="${camera_mass*(csy*csy+csz*csz)/12}" ixy="0" ixz="0"
               iyy="${camera_mass*(csx*csx+csz*csz)/12}" iyz="0"
               izz="${camera_mass*(csx*csx+csy*csy)/12}"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="body_link"/><child link="camera_link"/>
    <origin xyz="${camera_xyz}" rpy="${camera_rpy}"/>
  </joint>
  <!-- REP-103 optical frame: z forward, x right, y down -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

</robot>
