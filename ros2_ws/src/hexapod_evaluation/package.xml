<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexapod_evaluation</name>
  <version>0.1.0</version>
  <description>Experiment runners and metrics for the simulation test plan (E1-E7): shared statistics, target generation, E1 IK/FK accuracy (offline and fixed-base Gazebo), E2 walking trials and locomotion metrics (SSM, slip, CoT, success/fall).</description>
  <maintainer email="n.thanadett@gmail.com">T</maintainer>
  <license>Apache-2.0</license>

  <depend>hexapod_kinematics</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>hexapod_interfaces</depend>
  <depend>python3-yaml</depend>
  <depend>ament_index_python</depend>
  <depend>python3-numpy</depend>

  <exec_depend>hexapod_description</exec_depend>
  <exec_depend>hexapod_bringup</exec_depend>
  <exec_depend>hexapod_simulation</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>hexapod_locomotion</exec_depend>
  <exec_depend>rosbag2</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
