  <version>0.1.0</version>
  <description>Forward/inverse kinematics for the six 3-DOF CAD leg chains, parsed directly from the expanded robot_description.</description>
  <maintainer email="n.thanadett@gmail.com">T</maintainer>
  <license>Apache-2.0</license>

  <depend>python3-numpy</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
