<?xml version="1.0"?>
<sdf version="1.10">
  <world name="hexapod_training_course">
    <physics name="default" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <!-- Contact system: needed for the six foot contact sensors (limit-switch emulation) in hexapod_description -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <!-- ForceTorque system: joint torque sensors (use_joint_ft in hexapod_description, CoT in hexapod_evaluation) -->
    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque"/>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.72 0.82 0.92 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.4 0.2 -0.9</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
    </light>

    <!-- The box is centred at z=-0.05, keeping its top surface at z=0. -->
    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 5 0.1</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 5 0.1</size></box></geometry>
          <material><diffuse>0.45 0.48 0.50 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="boundary_walls">
      <static>true</static>
      <link name="walls">
        <collision name="north"><pose>0 2.5 0.2 0 0 0</pose><geometry><box><size>12 0.1 0.4</size></box></geometry></collision>
        <visual name="north_visual"><pose>0 2.5 0.2 0 0 0</pose><geometry><box><size>12 0.1 0.4</size></box></geometry><material><diffuse>0.18 0.22 0.28 1</diffuse></material></visual>
        <collision name="south"><pose>0 -2.5 0.2 0 0 0</pose><geometry><box><size>12 0.1 0.4</size></box></geometry></collision>
        <visual name="south_visual"><pose>0 -2.5 0.2 0 0 0</pose><geometry><box><size>12 0.1 0.4</size></box></geometry><material><diffuse>0.18 0.22 0.28 1</diffuse></material></visual>
        <collision name="east"><pose>6 0 0.2 0 0 0</pose><geometry><box><size>0.1 5 0.4</size></box></geometry></collision>
        <visual name="east_visual"><pose>6 0 0.2 0 0 0</pose><geometry><box><size>0.1 5 0.4</size></box></geometry><material><diffuse>0.18 0.22 0.28 1</diffuse></material></visual>
        <collision name="west"><pose>-6 0 0.2 0 0 0</pose><geometry><box><size>0.1 5 0.4</size></box></geometry></collision>
        <visual name="west_visual"><pose>-6 0 0.2 0 0 0</pose><geometry><box><size>0.1 5 0.4</size></box></geometry><material><diffuse>0.18 0.22 0.28 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Narrow centre obstacles pass between the feet and test body clearance. -->
    <model name="body_clearance_boxes">
      <static>true</static>
      <link name="boxes">
        <collision name="box_75mm"><pose>-4.55 -1.4 0.0375 0 0 0</pose><geometry><box><size>0.30 0.16 0.075</size></box></geometry></collision>
        <visual name="box_75mm_visual"><pose>-4.55 -1.4 0.0375 0 0 0</pose><geometry><box><size>0.30 0.16 0.075</size></box></geometry><material><diffuse>0.90 0.35 0.10 1</diffuse></material></visual>
        <collision name="box_90mm"><pose>-3.55 -1.4 0.045 0 0 0</pose><geometry><box><size>0.30 0.16 0.09</size></box></geometry></collision>
        <visual name="box_90mm_visual"><pose>-3.55 -1.4 0.045 0 0 0</pose><geometry><box><size>0.30 0.16 0.09</size></box></geometry><material><diffuse>0.95 0.15 0.08 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 1 m ramps rise 0.12 m (6.84 degrees), with a 0.6 m top platform. -->
    <model name="slope_module">
      <static>true</static>
      <link name="ramps">
        <collision name="ramp_up"><pose>-2.3 -1.4 0.0302 0 -0.11943 0</pose><geometry><box><size>1.0 1.0 0.06</size></box></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="ramp_up_visual"><pose>-2.3 -1.4 0.0302 0 -0.11943 0</pose><geometry><box><size>1.0 1.0 0.06</size></box></geometry><material><diffuse>0.18 0.58 0.28 1</diffuse></material></visual>
        <collision name="platform"><pose>-1.5 -1.4 0.09 0 0 0</pose><geometry><box><size>0.6 1.0 0.06</size></box></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="platform_visual"><pose>-1.5 -1.4 0.09 0 0 0</pose><geometry><box><size>0.6 1.0 0.06</size></box></geometry><material><diffuse>0.12 0.50 0.22 1</diffuse></material></visual>
        <collision name="ramp_down"><pose>-0.7 -1.4 0.0302 0 0.11943 0</pose><geometry><box><size>1.0 1.0 0.06</size></box></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="ramp_down_visual"><pose>-0.7 -1.4 0.0302 0 0.11943 0</pose><geometry><box><size>1.0 1.0 0.06</size></box></geometry><material><diffuse>0.18 0.58 0.28 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Alternating pylons form a compact slalom after the slope. -->
    <model name="zigzag_pylons">
      <static>true</static>
      <link name="pylons">
        <collision name="pylon_1"><pose>0.8 -0.95 0.225 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="pylon_1_visual"><pose>0.8 -0.95 0.225 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.45</length></cylinder></geometry><material><diffuse>0.95 0.75 0.08 1</diffuse></material></visual>
        <collision name="pylon_2"><pose>1.8 -1.85 0.225 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="pylon_2_visual"><pose>1.8 -1.85 0.225 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.45</length></cylinder></geometry><material><diffuse>0.95 0.75 0.08 1</diffuse></material></visual>
        <collision name="pylon_3"><pose>2.8 -0.95 0.225 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="pylon_3_visual"><pose>2.8 -0.95 0.225 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.45</length></cylinder></geometry><material><diffuse>0.95 0.75 0.08 1</diffuse></material></visual>
        <collision name="pylon_4"><pose>3.8 -1.85 0.225 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="pylon_4_visual"><pose>3.8 -1.85 0.225 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.45</length></cylinder></geometry><material><diffuse>0.95 0.75 0.08 1</diffuse></material></visual>
      </link>
    </model>

    <model name="finish_marker">
      <static>true</static>
      <pose>5.0 -1.4 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.08 1.0 0.02</size></box></geometry><material><diffuse>0.1 0.8 0.9 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
