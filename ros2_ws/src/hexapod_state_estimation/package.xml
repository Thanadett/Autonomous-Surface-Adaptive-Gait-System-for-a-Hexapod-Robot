<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexapod_state_estimation</name>
  <version>0.1.0</version>
  <description>IMU attitude estimate (/state/attitude, complementary filter). Foot-contact processing and the fused TerrainFeatures publisher are not implemented yet.</description>
  <maintainer email="n.thanadett@gmail.com">T</maintainer>
  <license>Apache-2.0</license>

  <depend>hexapod_interfaces</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
